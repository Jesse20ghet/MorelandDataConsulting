---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/og-default.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: {
    '@type': 'Person',
    name: 'Jesse Moreland',
    url: 'https://morelanddataconsulting.com/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Moreland Data Consulting',
    url: 'https://morelanddataconsulting.com/',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  image: ogImage,
};
---
<Base
  title={`${post.data.title} — Moreland Data Consulting`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="wrap">
    <article class="post">
      <div class="post-meta">
        {fmt(post.data.pubDate)}
        {post.data.updatedDate && ` · Updated ${fmt(post.data.updatedDate)}`}
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>

      <div class="prose">
        <Content />
      </div>

      <div class="post-foot">
        <a href="/blog" class="back">← All posts</a>
        <a href="/#contact" class="cta">Got a SQL Server that's slow? →</a>
      </div>
    </article>
  </div>
</Base>
