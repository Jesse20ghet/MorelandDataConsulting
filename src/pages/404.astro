---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found — Moreland Data Consulting"
  description="That page doesn't exist. Head back home or browse the blog."
>
  <div class="wrap" style="text-align:center; padding: 80px 0;">
    <div class="eyebrow">404</div>
    <h1>That page ran off.</h1>
    <p style="max-width:520px; margin: 12px auto 28px;">
      The page you're looking for doesn't exist or has moved. Let's get you back on track.
    </p>
    <p>
      <a href="/" class="cta">← Back home</a>
      &nbsp;·&nbsp;
      <a href="/blog">Read the blog</a>
    </p>
  </div>
</Base>
